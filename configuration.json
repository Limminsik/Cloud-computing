{
  "services": {
    "frontend_port": 3000,
    "backend_port": 4000,
    "ai_service_port": 8000
  },

  "agents": {
    "identification": "gemini-2.5-flash-lite",
    "screening":      "gemini-2.5-flash-lite",
    "eligibility":    "claude-sonnet-4-6",
    "writer":         "claude-opus-4-7"
  },

  "prisma_stages": ["identification", "screening", "eligibility", "inclusion"],

  "search": {
    "sources": ["pubmed", "semantic_scholar", "google_scholar"],
    "max_results_per_source": 200,
    "scholar_page_size": 10,
    "scholar_max_pages": 5
  },

  "pipeline": {
    "screening_batch_size": 50,
    "eligibility_concurrent": 5,
    "eligibility_max_tokens": 1024
  },

  "features": {
    "fetch_fulltext": true,
    "auto_generate_criteria": true
  }
}
